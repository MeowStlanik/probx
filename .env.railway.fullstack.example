# ProbX — Railway fullstack (UI + API + workers in one service)
# Railway injects PORT automatically. Do not add PORT manually.

NODE_ENV=production
HOST=0.0.0.0

# Public site and same-origin API
NEXT_PUBLIC_SITE_URL=https://probx.up.railway.app
SITE_URL=https://probx.up.railway.app
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=https://probx.up.railway.app

# Arc Testnet
NEXT_PUBLIC_CHAIN_ID=5042002
# Keep the private dRPC key server-only. Browser reads use the public Arc endpoint.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URLS=
ARC_RPC_URL=https://lb.drpc.live/arc-testnet/REPLACE_WITH_NEW_DRPC_KEY
ARC_RPC_URLS=
RPC_ENABLE_PUBLIC_FALLBACK=0
ARC_FROM_BLOCK=55100000
ARC_RECENT_SCAN_BLOCKS=20000
ARC_LOG_CHUNK_SIZE=9000
ARC_MARKET_LIST_LIMIT=18
ARC_MARKET_STATS_SCAN_BLOCKS=8000

# Deployed contracts
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_MICRO_BOOST_ENGINE_ADDRESS=0x469592aEff57eE56e910A75eA69a6538E8B59A67
NEXT_PUBLIC_LIQUIDITY_POOL_ADDRESS=0xdB25f054D2D88c38FB06f74ADaD1b06e87a06De8
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=0xf659eDf16E55307095a08fd29727316513acdF19

# Persistent workers — balanced demo / RPC budget
BACKGROUND_WORKERS_ENABLED=1
MARKET_CYCLE_ENABLED=1
MARKET_CYCLE_INTERVAL_MS=20000
ORACLE_SNAPSHOT_ENABLED=1
ORACLE_SNAPSHOT_INTERVAL_MS=5000
AUTO_RESOLVE_ENABLED=0
AUTO_RESOLVE_INTERVAL_MS=10000

# RPC/cache budget
RPC_MARKET_CACHE_MS=300000
RPC_PUBLIC_MARKET_CACHE_MS=30000
RPC_TICKET_CACHE_MS=60000
AGGREGATE_STATS_FRESH_MS=600000
RPC_BATCH=1
RPC_BATCH_SIZE=3

# On-chain signer keys — create new values; do not reuse exposed keys
ORACLE_PRIVATE_KEY=REPLACE_WITH_NEW_PRIVATE_KEY
DEPLOYER_PRIVATE_KEY=REPLACE_WITH_NEW_PRIVATE_KEY
PRIVATE_KEY=REPLACE_WITH_NEW_PRIVATE_KEY
OWNER_PRIVATE_KEY=REPLACE_WITH_NEW_PRIVATE_KEY

# Session/admin secrets — generate new random values
SESSION_HMAC_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
SESSION_WALLET_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
OTP_HMAC_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
ADMIN_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
CRON_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
CRON_THROTTLE_MS=30000

# Gmail API (HTTPS; SMTP variables are not used)
# Create a Desktop OAuth client, then run locally:
# GMAIL_OAUTH_CLIENT_ID='...' GMAIL_OAUTH_CLIENT_SECRET='...' pnpm gmail:oauth
GMAIL_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GMAIL_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GMAIL_OAUTH_REFRESH_TOKEN=REPLACE_WITH_REFRESH_TOKEN
GMAIL_SENDER_EMAIL=REPLACE_WITH_SENDER_GMAIL
GMAIL_SENDER_NAME=ProbX Arc
EMAIL_OTP_REQUIRED=1
EMAIL_OTP_DEV_ECHO=0

# Upstash Redis — rotate the token that was exposed
UPSTASH_REDIS_REST_URL=REPLACE_WITH_UPSTASH_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_NEW_UPSTASH_TOKEN

# Circle — rotate exposed credentials
NEXT_PUBLIC_CIRCLE_KIT_KEY=REPLACE_WITH_CIRCLE_KIT_KEY
CIRCLE_API_KEY=REPLACE_WITH_NEW_CIRCLE_API_KEY
CIRCLE_ENTITY_SECRET=REPLACE_WITH_NEW_CIRCLE_ENTITY_SECRET
CIRCLE_WALLET_SET_ID=REPLACE_WITH_WALLET_SET_ID

# Optional CCTP demo funding
CCTP_SOURCE_PRIVATE_KEY=REPLACE_WITH_NEW_PRIVATE_KEY
CCTP_DEMO_MAX_PER_CALL=10
CCTP_DEMO_DAILY_PER_ADDRESS=25
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
