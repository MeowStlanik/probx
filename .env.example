# --- Vercel UI variables ---
NEXT_PUBLIC_CHAIN_ID=5042002
# Keep browser traffic off the private dRPC endpoint; wallet reads can use Arc public RPC.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URLS=
# On Vercel, set the full Railway API origin (no trailing /api).
NEXT_PUBLIC_API_BASE_URL=
# Set after Railway creates the public domain, e.g. https://your-app.up.railway.app
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_MICRO_BOOST_ENGINE_ADDRESS=0x469592aEff57eE56e910A75eA69a6538E8B59A67
NEXT_PUBLIC_LIQUIDITY_POOL_ADDRESS=0xdB25f054D2D88c38FB06f74ADaD1b06e87a06De8
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=0xf659eDf16E55307095a08fd29727316513acdF19

# --- Railway standalone API server ---
# Railway injects PORT automatically. Do not hard-code it in production.
SITE_URL=
# Set explicitly on Railway.
NODE_ENV=production
# Required on the persistent Railway backend. Set 0 (or leave unset) on Vercel.
BACKGROUND_WORKERS_ENABLED=1
RUNTIME_DIR=

# --- Arc API / contracts ---
# Put the private dRPC endpoint here. With an explicit URL no public fallback is used.
ARC_RPC_URL=
ARC_RPC_URLS=
RPC_ENABLE_PUBLIC_FALLBACK=0
ARC_FROM_BLOCK=53938140
ORACLE_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
PRIVATE_KEY=
OWNER_PRIVATE_KEY=

# Persistent process workers: one market cycle + a lightweight boundary sampler.
MARKET_CYCLE_ENABLED=1
MARKET_CYCLE_INTERVAL_MS=30000
# Boundary samples must be captured more often than BTC_SNAPSHOT_MAX_DIST_MS (35s).
# The sampler uses cached market metadata and fetches feeds only near boundaries.
ORACLE_SNAPSHOT_ENABLED=1
ORACLE_SNAPSHOT_INTERVAL_MS=7000
# Keep disabled on the same Railway service: market-cycle already resolves markets.
# Enable only if you intentionally deploy a separate resolver process.
AUTO_RESOLVE_ENABLED=0
AUTO_RESOLVE_INTERVAL_MS=10000

# RPC budget controls. One full factory/market reconciliation is shared by all
# routes/workers; cached schedules are used between refreshes.
RPC_MARKET_CACHE_MS=300000
RPC_PUBLIC_MARKET_CACHE_MS=60000
RPC_TICKET_CACHE_MS=60000
ARC_MARKET_LIST_LIMIT=18
ARC_MARKET_STATS_SCAN_BLOCKS=8000
AGGREGATE_STATS_FRESH_MS=600000

# Manual cron endpoints remain available for diagnostics / emergency runs.
CRON_SECRET=
CRON_THROTTLE_MS=10000
ADMIN_SECRET=
# Standalone API bind address and allowed Vercel origin(s).
HOST=0.0.0.0
CORS_ORIGINS=

# --- Circle Developer-Controlled Wallets ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_KIT_KEY=
NEXT_PUBLIC_CIRCLE_KIT_KEY=
APP_KIT_STRICT=
NEXT_PUBLIC_APP_KIT_STRICT=

# Optional server-side CCTP funding from testnet treasuries.
CCTP_SOURCE_PRIVATE_KEY=
CCTP_DEMO_MAX_PER_CALL=10
CCTP_DEMO_DAILY_PER_ADDRESS=25
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Gmail API email OTP (HTTPS; no SMTP ports) ---
# Create a Google OAuth client and run locally:
#   GMAIL_OAUTH_CLIENT_ID=... GMAIL_OAUTH_CLIENT_SECRET=... pnpm gmail:oauth
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=ProbX Arc
EMAIL_OTP_DEV_ECHO=
EMAIL_OTP_REQUIRED=1
OTP_HMAC_SECRET=
SESSION_HMAC_SECRET=
SESSION_WALLET_SECRET=

# --- Durable Redis KV (required in production for OTP single-use, rate limits,
# wallet mapping, locks and transaction state) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Performance ---
RPC_BATCH=1
RPC_BATCH_SIZE=3
